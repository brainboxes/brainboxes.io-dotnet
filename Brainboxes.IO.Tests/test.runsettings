<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Disable parallelization to prevent hardware conflicts -->
    <!-- Tests communicate with the same physical device, so parallel execution causes issues -->
    <MaxCpuCount>1</MaxCpuCount>

    <!-- Total timeout for the entire test session (ms) - 2 hours -->
    <TestSessionTimeout>7200000</TestSessionTimeout>
  </RunConfiguration>

  <MSTest>
    <!-- Run tests in the same AppDomain (faster, less isolation) -->
    <AppDomain>None</AppDomain>

    <!-- Disable in-process isolation for better debugging -->
    <InIsolation>false</InIsolation>

    <!-- Capture output for debugging -->
    <CaptureTraceOutput>true</CaptureTraceOutput>

    <!-- Default test timeout per test (ms) - 2 minutes -->
    <!-- Overridden by [Timeout] attribute on individual tests -->
    <TestTimeout>120000</TestTimeout>

    <!-- Treat Inconclusive as test skip, not failure -->
    <MapInconclusiveToFailed>false</MapInconclusiveToFailed>
  </MSTest>
</RunSettings>
