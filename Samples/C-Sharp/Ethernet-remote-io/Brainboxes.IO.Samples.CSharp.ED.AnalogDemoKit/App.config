<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="../logs/log-%property{MAC}.log" />
      <preserveLogFileNameExtension value="true" />
      <dateTimeStrategy type="log4net.Appender.RollingFileAppender+UniversalDateTime" />
      <rollingStyle value="Date" />
      <appendToFile value="true" />
      <datePattern value="-yyyy-MM-dd" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%utcdate{ISO8601} %logger{1} %-6p %m%n" />
      </layout>
    </appender>

    <appender name="RollingFileInternetStatusAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="../logs/internet-status.log" />
      <dateTimeStrategy type="log4net.Appender.RollingFileAppender+UniversalDateTime" />
      <preserveLogFileNameExtension value="true" />
      <rollingStyle value="Date" />
      <appendToFile value="true" />
      <datePattern value="-yyyy-MM" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%utcdate{ISO8601} %logger{1} %-6p %m%n" />
      </layout>
    </appender>

    <appender name="RollingFileRemoteIOStatusAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="../logs/ed-status.log" />
      <dateTimeStrategy type="log4net.Appender.RollingFileAppender+UniversalDateTime" />
      <preserveLogFileNameExtension value="true" />
      <rollingStyle value="Date" />
      <appendToFile value="true" />
      <datePattern value="-yyyy-MM" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%utcdate{ISO8601} %logger{1} %-6p %m%n" />
      </layout>
    </appender>

    <appender name="Waste20CSVDataRollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="../csv/w2odata-%property{MAC}.csv" />
      <preserveLogFileNameExtension value="true" />
      <dateTimeStrategy type="log4net.Appender.RollingFileAppender+UniversalDateTime" />
      <rollingStyle value="Date" />
      <datePattern value="-yyyy-MM" />
      <appendToFile value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%m%n" />
      </layout>
    </appender>

    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%utcdate{ISO8601} %logger{1} %-6p %m%n" />
      </layout>
    </appender>

    <root>
      <level value="INFO" />
      <appender-ref ref="RollingFileAppender" />
      <appender-ref ref="ConsoleAppender" />
    </root>

    <logger name="CSVLogger">
      <level value="INFO" />
      <appender-ref ref="Waste20CSVDataRollingFileAppender" />
    </logger>
    <logger name="EDUDPDeviceFinder">
    </logger>

    <logger name="InternetStatusLogger">
      <level value="INFO" />
      <appender-ref ref="RollingFileInternetStatusAppender" />
    </logger>


    <logger name="RemoteIOStatusLogger">
      <level value="INFO" />
      <appender-ref ref="RollingFileRemoteIOStatusAppender" />
    </logger>

  </log4net>
</configuration>